{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bant",
  "version": "1.1.0",
  "identifier": "com.bant.resistorstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Bant — Direnç renk kodları", "width": 1320, "height": 860, "minWidth": 900, "minHeight": 670, "backgroundColor": "#f4f6f8" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "vendor/libgcc_s_seh_64-1.dll": "libgcc_s_seh_64-1.dll",
      "vendor/COPYING.RUNTIME-gcc-tdm.txt": "licenses/COPYING.RUNTIME-gcc-tdm.txt",
      "vendor/COPYING3-gcc-tdm.txt": "licenses/COPYING3-gcc-tdm.txt"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper", "silent": true } }
  }
}
